# Port for local dev (Vercel ignores this)
PORT=3001

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# "groq" (default) or "gemini". Both have a free tier.
#   Groq key:   https://console.groq.com/keys
#   Gemini key: https://aistudio.google.com/apikey
LLM_PROVIDER=groq
LLM_API_KEY=

# Optional overrides. Leave empty to use the provider defaults:
#   groq   -> https://api.groq.com/openai/v1, openai/gpt-oss-120b
#   gemini -> https://generativelanguage.googleapis.com/v1beta/openai, gemini-flash-latest
# Any other OpenAI-compatible API works by setting both.
LLM_BASE_URL=
LLM_MODEL=

# Optional. "low" gives a faster first token on reasoning models like gpt-oss.
# Leave empty if your model doesn't support it.
LLM_REASONING_EFFORT=low

# Requests allowed per IP per window (simple in-memory limit)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=600000

# Only for local UI work without a key. Never enable it in production.
LLM_MOCK=false

# Time zone used to decide what "today" is when logging data
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Optional: keep manually added days in Upstash Redis (free tier, Vercel Marketplace).
# Without these, added days live in memory and reset when the server restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required on Vercel / in production: a stable random secret, at least 32 characters.
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit the real value or put it in a VITE_ variable.
SESSION_SECRET=
